{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InventoryApi": {
    "ApiKeyHeaderName": "X-Api-Key",
    "PageSize": 25,
    "MaxAttemptsPerPage": 4,
    "AttemptTimeout": "00:00:10",
    "BaseRetryDelay": "00:00:00.500",
    "MaxRetryDelay": "00:00:05",
    "MaxRetryAfter": "00:00:10",
    "TotalTimeout": "00:01:00"
  }
}
